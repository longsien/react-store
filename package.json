{
  "name": "@longsien/react-store",
  "version": "1.3.2",
  "workspaces": [
    "examples/demo"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "build:dev": "rm -rf dist && babel src -d dist --copy-files",
    "build:min": "BABEL_ENV=minify babel src -d dist --copy-files --out-file-extension .min.js",
    "build": "npm run build:dev && npm run build:min",
    "prepare": "npm run build",
    "test": "vitest",
    "demo": "vite examples/demo"
  },
  "author": "Long Sien",
  "homepage": "https://github.com/longsien/react-store#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longsien/react-store.git"
  },
  "bugs": {
    "url": "https://github.com/longsien/react-store/issues"
  },
  "description": "A lightweight, proxy-based state management library for React.",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-preset-minify": "^0.5.2",
    "baseline-browser-mapping": "^2.10.34",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vitest-localstorage-mock": "^0.1.2"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "state",
    "store",
    "management",
    "global",
    "hook",
    "proxy"
  ],
  "dependencies": {
    "fast-equals": "^6.0.0"
  }
}
